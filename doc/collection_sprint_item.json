			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"sprintId\": 1,\n  \"tarefaId\": 1\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/sprint-items",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "sprint-items"]
				}
			},
			"response": []
		},
